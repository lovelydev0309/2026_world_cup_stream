[Unit]
Description=Real-time channel liveness -> player/live.json (fast tier of the health dashboard)
After=streaming-rpa.service
PartOf=streaming-rpa.service

[Service]
Type=simple
# A loop rather than a timer: cron/systemd timers are minute-granular and this needs ~5s.
# The scan is ~0.04s of stat() calls over the local HLS dirs, so the duty cycle is ~1%.
ExecStart=/bin/bash -c 'while true; do /usr/bin/python3 /opt/streaming-stack/scripts/live_status.py || true; sleep 5; done'
Restart=always
RestartSec=5
# Never let the dashboard compete with the encoders for CPU.
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target

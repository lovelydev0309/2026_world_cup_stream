[Unit]
Description=MajoTV Telegram menu bot (@majotvwatch_bot, long-polling, Spanish)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SHOP=majo
WorkingDirectory=/opt/streaming-stack/telegram
ExecStart=/usr/bin/python3 /opt/streaming-stack/telegram/kozee_bot.py
Restart=always
RestartSec=5
StandardOutput=append:/opt/streaming-stack/logs/majo_bot.log
StandardError=append:/opt/streaming-stack/logs/majo_bot.log

[Install]
WantedBy=multi-user.target

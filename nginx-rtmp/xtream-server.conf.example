# Xtream gateway routing — paste into nginx.conf on the box (it is bind-mounted live, so
# this stays an example until deploy).
#
# Members use the DNS tv1.sazatv.com = Bunny pull zone 6813050 -> this origin. Bunny
# doesn't forward that hostname, so the gateway is routed BY PATH inside the existing
# origin servers (both `listen 8080` and `listen 443`), not by a server_name block.
# The gateway builds its links from XTREAM_PUBLIC_HOST and reads the viewer's address
# from X-Forwarded-For, which Bunny sets.
#
# Everything goes to the gateway, including signed VOD files (/xv/...): the
# alfg/nginx-rtmp image has no auth_request/secure_link, so nginx can't verify them.

# ── 1. In http{}, next to the other maps ──────────────────────────────────────────
    # Scheme the VIEWER used: Bunny's X-Forwarded-Proto when present, else our own.
    map $http_x_forwarded_proto $xt_proto {
        ""      $scheme;
        default $http_x_forwarded_proto;
    }

# ── 2. In BOTH origin server{} blocks (listen 8080 and listen 443) ───────────────
        # Xtream gateway (IPTV apps). Regex location, so it wins over plain prefixes;
        # none of these paths exist elsewhere on the origin.
        location ~ ^/(player_api\.php|get\.php|xmltv\.php|live/|movie/|xv/) {
            proxy_pass http://172.17.0.1:8091;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $xt_proto;
            proxy_read_timeout 30s;
            proxy_max_temp_file_size 0;   # stream VOD segments through, never spool to disk
            access_log off;               # every app URL carries a member's password
        }

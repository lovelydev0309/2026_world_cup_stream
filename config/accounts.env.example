# Template for config/accounts.env (server only, git-ignored). Copy, fill in, chmod 600.
# Never commit real values. Provider accounts are  ALIAS=host:port/username/password
# and are referenced from config/channels.json as  http://@@ALIAS@@/<stream_id>.

# ── Provider accounts ──────────────────────────────────────────────────────────
ACCT1=provider.example:80/username/password
ACCT_LAT1=provider.example:80/username/password
ACCT_PE1=provider.example:80/username/password
KOZEE1=provider.example:80/username/password
# One-connection South Africa lines (never polled via player_api)
ACCT_ZA1=seller.example:80/username/password
ACCT_ZA_TEST=seller.example:80/username/password


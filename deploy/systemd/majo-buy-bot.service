[Unit]
Description=majo buy bot (Telegram Stars payments)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/streaming-stack
Environment=SHOP=majo
ExecStart=/usr/bin/python3 /opt/streaming-stack/src/telegram/buy_bot.py
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target

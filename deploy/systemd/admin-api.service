[Unit]
Description=Live channel admin API
After=network-online.target docker.service
[Service]
Type=simple
WorkingDirectory=/opt/streaming-stack
# ADMIN_BIND / ADMIN_PORT / ADMIN_TOKEN live in this git-ignored file (see docs/CONFIGURATION.md)
EnvironmentFile=/opt/streaming-stack/config/admin-api.env
ExecStart=/usr/bin/python3 /opt/streaming-stack/src/gateway/admin_api.py
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
